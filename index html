<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#1e4d37">
<title>减肥工作台 Pro</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,system-ui,'PingFang SC',sans-serif;background:#eef4f0;min-height:100vh;padding:12px;color:#1a3b2e;-webkit-font-smoothing:antialiased}
.app{max-width:480px;margin:0 auto}
.card{background:#fff;border-radius:22px;padding:20px 18px;box-shadow:0 4px 20px rgba(20,60,40,.06);margin-bottom:14px}
h1{font-size:22px;display:flex;align-items:center;gap:6px;margin-bottom:4px}
.sub{font-size:12.5px;color:#5e7b6e;display:flex;justify-content:space-between;margin-bottom:6px}
.date-badge{background:#e5f0e9;padding:3px 10px;border-radius:20px;color:#1e5e3f;font-weight:600}
.section-title{font-size:14px;font-weight:700;color:#1a3b2e;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.section-title .tag{font-size:10px;background:#e5f0e9;color:#2b6e4f;padding:2px 8px;border-radius:20px;font-weight:600}

/* 表单 */
.field{margin-bottom:14px}
.field label{display:block;font-size:12.5px;font-weight:600;color:#5e7b6e;margin-bottom:6px}
.field input,.field select{width:100%;padding:12px 14px;border:1.5px solid #dde9e2;border-radius:14px;font-size:15px;color:#1a3b2e;background:#f9fcfb;outline:none;font-family:inherit;font-weight:500}
.field input:focus,.field select:focus{border-color:#1e4d37;background:#fff}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.radio-group{display:flex;gap:8px}
.radio-group label{flex:1;padding:11px;border:1.5px solid #dde9e2;border-radius:14px;text-align:center;font-size:14px;font-weight:600;color:#5e7b6e;cursor:pointer;background:#f9fcfb;transition:.15s}
.radio-group input{display:none}
.radio-group input:checked+span{color:#fff}
.radio-group label:has(input:checked){background:#1e4d37;border-color:#1e4d37;color:#fff}

.btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:14px;border:none;border-radius:16px;font-size:15px;font-weight:600;cursor:pointer;font-family:inherit;width:100%;transition:.15s}
.btn-primary{background:#1e4d37;color:#fff;box-shadow:0 6px 16px rgba(30,77,55,.2)}
.btn-primary:active{transform:scale(.98)}
.btn-outline{background:#fff;border:1.5px solid #c2d9cd;color:#1e4d37}
.btn-sm{padding:9px 14px;font-size:13px;width:auto;border-radius:12px}

/* 数据卡片 */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:#f8fbf9;border-radius:18px;padding:14px;border:1px solid #dde9e2}
.stat.hl{background:linear-gradient(135deg,#1e4d37,#2b6e4f);color:#fff;border:none;box-shadow:0 8px 20px rgba(30,77,55,.2)}
.stat .k{font-size:11.5px;font-weight:500;opacity:.85;margin-bottom:6px;display:flex;align-items:center;gap:4px}
.stat .v{font-size:24px;font-weight:800;letter-spacing:-.5px;line-height:1;display:flex;align-items:baseline;gap:3px}
.stat .v small{font-size:12px;font-weight:500;opacity:.7}
.stat .sub{font-size:10.5px;margin-top:5px;opacity:.7}

/* 进度条 */
.prog{height:10px;background:#e0ebe5;border-radius:20px;overflow:hidden;margin:8px 0}
.prog-fill{height:100%;background:linear-gradient(90deg,#4a9e7a,#1e4d37);border-radius:20px;transition:width .4s;width:0}

/* 拍照 */
.photo-zone{display:flex;gap:12px;align-items:center}
.preview{width:74px;height:74px;border-radius:16px;background:#eaf1ed;display:flex;align-items:center;justify-content:center;font-size:30px;overflow:hidden;border:1.5px dashed #b6cfc2;flex-shrink:0}
.preview img{width:100%;height:100%;object-fit:cover}
.acts{flex:1;display:flex;flex-direction:column;gap:8px}
.filebtn,.recbtn{display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;border-radius:14px;font-size:13.5px;font-weight:600;cursor:pointer;border:none;width:100%;font-family:inherit}
.filebtn{background:#fff;border:1.5px solid #c2d9cd;color:#1e4d37}
.filebtn input{display:none}
.recbtn{background:#1e4d37;color:#fff}
.recbtn:disabled{background:#a8beb2}
.result{font-size:12px;color:#2b6e4f;margin-top:10px;min-height:16px;font-weight:500}

/* 记录 */
.lhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.list{list-style:none;display:flex;flex-direction:column;gap:6px;max-height:220px;overflow-y:auto}
.item{background:#f6faf8;border-radius:14px;padding:11px 13px;font-size:13px;display:flex;justify-content:space-between;align-items:center;border:1px solid #e2ede7;animation:fade .2s}
@keyframes fade{from{opacity:0;transform:translateY(-4px)}to{opacity:1}}
.item .name{font-weight:600;color:#1e3b2e}
.item .cal{font-weight:700;color:#0b4128;background:#d9ebe2;padding:2px 9px;border-radius:20px;font-size:12px;margin-left:6px}
.del{background:none;border:none;font-size:16px;color:#a1b9ac;padding:0 4px;cursor:pointer}
.empty{text-align:center;padding:16px 0;color:#9bb3a7;font-size:13px;font-style:italic}

/* 提示条 */
.tip{background:#fff8e6;border:1px solid #f0dcae;border-radius:14px;padding:12px 14px;font-size:12.5px;color:#7a5f1a;line-height:1.6;margin-bottom:14px}
.tip b{color:#5a4410}

/* 隐藏/显示 */
.hidden{display:none!important}

/* 弹层 */
.modal{position:fixed;inset:0;background:rgba(20,40,30,.5);display:flex;align-items:center;justify-content:center;padding:20px;z-index:99;animation:fade .2s}
.modal-box{background:#fff;border-radius:22px;padding:22px;max-width:400px;width:100%}
.modal-box h3{font-size:17px;margin-bottom:14px}

.toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%) translateY(100px);background:rgba(30,77,55,.95);color:#fff;padding:12px 22px;border-radius:30px;font-size:13.5px;font-weight:500;opacity:0;transition:.3s;z-index:999;pointer-events:none;max-width:90vw;white-space:nowrap}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}
</style>
</head>
<body>
<div class="app" id="app">

  <!-- 引导设置（首次） -->
  <div class="card hidden" id="setupCard">
    <h1>🥗 减肥工作台 Pro</h1>
    <p style="font-size:13px;color:#5e7b6e;margin:8px 0 20px;line-height:1.6">
      先填写你的身体数据，我会算出你的<br>
      <b style="color:#1e4d37">基础代谢、每日消耗、建议热量缺口</b>。
    </p>

    <div class="field">
      <label>性别</label>
      <div class="radio-group">
        <label><input type="radio" name="sex" value="male"><span>👨 男</span></label>
        <label><input type="radio" name="sex" value="female" checked><span>👩 女</span></label>
      </div>
    </div>

    <div class="row2">
      <div class="field">
        <label>年龄</label>
        <input type="number" id="age" placeholder="28" value="28" min="10" max="100">
      </div>
      <div class="field">
        <label>身高 (cm)</label>
        <input type="number" id="height" placeholder="165" value="165" min="100" max="230">
      </div>
    </div>

    <div class="row2">
      <div class="field">
        <label>当前体重 (kg)</label>
        <input type="number" id="weight" placeholder="65" value="65" step="0.1" min="30" max="250">
      </div>
      <div class="field">
        <label>目标体重 (kg)</label>
        <input type="number" id="target" placeholder="55" value="55" step="0.1" min="30" max="250">
      </div>
    </div>

    <div class="field">
      <label>活动量</label>
      <select id="activity">
        <option value="1.2">久坐（几乎不运动）</option>
        <option value="1.375" selected>轻度（每周运动1-3次）</option>
        <option value="1.55">中度（每周3-5次）</option>
        <option value="1.725">高度（每周6-7次）</option>
        <option value="1.9">极高（体力劳动/运动员）</option>
      </select>
    </div>

    <button class="btn btn-primary" id="calcBtn">✨ 生成我的方案</button>
  </div>

  <!-- 主界面 -->
  <div class="card hidden" id="mainCard">
    <h1>🥗 减肥工作台 Pro</h1>
    <div class="sub">
      <span id="greeting">你好</span>
      <span class="date-badge" id="dateBadge"></span>
    </div>

    <!-- 今日核心数据 -->
    <div class="grid2" style="margin-top:16px">
      <div class="stat">
        <div class="k">🍽️ 今日摄入</div>
        <div class="v" id="intakeVal">0<small>kcal</small></div>
        <div class="sub" id="intakeSub">暂无记录</div>
      </div>
      <div class="stat hl">
        <div class="k">🔥 今日缺口</div>
        <div class="v" id="deficitVal">0<small>kcal</small></div>
        <div class="sub" id="deficitSub">目标 500 kcal</div>
      </div>
    </div>

    <!-- 剩余可吃 -->
    <div style="margin-top:14px;background:#f8fbf9;border-radius:18px;padding:14px;border:1px solid #dde9e2">
      <div style="display:flex;justify-content:space-between;font-size:12.5px;color:#5e7b6e;margin-bottom:6px">
        <span>🍚 今日还可摄入</span>
        <span id="remainText">1500 kcal</span>
      </div>
      <div class="prog">
        <div class="prog-fill" id="intakeProg" style="width:0%"></div>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:11px;color:#7b9789">
        <span>已摄入 <b id="eatenText">0</b> kcal</span>
        <span>建议上限 <b id="limitText">1500</b> kcal</span>
      </div>
    </div>

    <!-- 方案摘要 -->
    <div style="margin-top:14px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;text-align:center">
      <div style="background:#f8fbf9;border-radius:14px;padding:10px 6px">
        <div style="font-size:10.5px;color:#7b9789;margin-bottom:4px">基础代谢</div>
        <div style="font-size:15px;font-weight:800;color:#1e4d37" id="bmrText">--</div>
      </div>
      <div style="background:#f8fbf9;border-radius:14px;padding:10px 6px">
        <div style="font-size:10.5px;color:#7b9789;margin-bottom:4px">每日消耗</div>
        <div style="font-size:15px;font-weight:800;color:#1e4d37" id="tdeeText">--</div>
      </div>
      <div style="background:#e5f0e9;border-radius:14px;padding:10px 6px">
        <div style="font-size:10.5px;color:#5e7b6e;margin-bottom:4px">建议摄入</div>
        <div style="font-size:15px;font-weight:800;color:#1e4d37" id="targetIntakeText">--</div>
      </div>
    </div>

    <!-- 个性化建议 -->
    <div class="tip" id="adviceBox" style="margin-top:14px">
      <b>💡 建议</b>：<span id="adviceText">正在计算...</span>
    </div>

    <div style="display:flex;gap:8px;margin-top:12px">
      <button class="btn btn-outline btn-sm" style="flex:1" id="editProfileBtn">✏️ 修改资料</button>
      <button class="btn btn-outline btn-sm" style="flex:1" id="weightLogBtn">⚖️ 记体重</button>
    </div>
  </div>

  <!-- 拍照识别 -->
  <div class="card hidden" id="cameraCard">
    <div class="section-title">📷 拍照识别卡路里 <span class="tag">AI</span></div>
    <div class="photo-zone">
      <div class="preview" id="previewBox">📸</div>
      <div class="acts">
        <label class="filebtn">📷 拍照 / 选图<input type="file" id="fileInput" accept="image/*" capture="environment"></label>
        <button class="recbtn" id="recognizeBtn" disabled>🔍 识别热量</button>
      </div>
    </div>
    <div class="result" id="recognizeMsg">✨ 上传食物照片，自动估算热量</div>
  </div>

  <!-- 手动输入 -->
  <div class="card hidden" id="manualCard">
    <div class="section-title">✏️ 手动添加</div>
    <div style="display:flex;gap:8px">
      <input type="number" id="manualInput" placeholder="卡路里 kcal" min="1" style="flex:1;padding:13px 16px;border:1.5px solid #dde9e2;border-radius:14px;font-size:15px;font-weight:600;color:#1a3b2e;background:#f9fcfb;outline:none;font-family:inherit">
      <button class="btn btn-primary" style="width:auto;padding:13px 22px" id="manualAddBtn">添加</button>
    </div>
  </div>

  <!-- 今日记录 -->
  <div class="card hidden" id="logCard">
    <div class="lhead">
      <div class="section-title" style="margin:0">📋 今日记录</div>
      <button class="btn btn-outline btn-sm" id="clearBtn" style="color:#b65c5c;border-color:#f0d5d5">清空</button>
    </div>
    <ul class="list" id="logList"><li class="empty">还没有记录</li></ul>
  </div>

</div>

<!-- 修改资料弹层 -->
<div class="modal hidden" id="profileModal">
  <div class="modal-box">
    <h3>✏️ 修改资料</h3>
    <div class="field">
      <label>性别</label>
      <div class="radio-group">
        <label><input type="radio" name="sex2" value="male"><span>👨 男</span></label>
        <label><input type="radio" name="sex2" value="female"><span>👩 女</span></label>
      </div>
    </div>
    <div class="row2">
      <div class="field"><label>年龄</label><input type="number" id="age2" min="10" max="100"></div>
      <div class="field"><label>身高 (cm)</label><input type="number" id="height2" min="100" max="230"></div>
    </div>
    <div class="row2">
      <div class="field"><label>当前体重 (kg)</label><input type="number" id="weight2" step="0.1" min="30" max="250"></div>
      <div class="field"><label>目标体重 (kg)</label><input type="number" id="target2" step="0.1" min="30" max="250"></div>
    </div>
    <div class="field">
      <label>活动量</label>
      <select id="activity2">
        <option value="1.2">久坐</option>
        <option value="1.375">轻度</option>
        <option value="1.55">中度</option>
        <option value="1.725">高度</option>
        <option value="1.9">极高</option>
      </select>
    </div>
    <div style="display:flex;gap:8px;margin-top:6px">
      <button class="btn btn-outline" id="cancelProfileBtn" style="flex:1">取消</button>
      <button class="btn btn-primary" id="saveProfileBtn" style="flex:1">保存</button>
    </div>
  </div>
</div>

<!-- 记体重弹层 -->
<div class="modal hidden" id="weightModal">
  <div class="modal-box">
    <h3>⚖️ 记录今日体重</h3>
    <div class="field">
      <label>体重 (kg)</label>
      <input type="number" id="newWeight" step="0.1" min="30" max="250" placeholder="例如 64.5">
    </div>
    <div id="weightHistory" style="max-height:140px;overflow-y:auto;margin-bottom:12px"></div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-outline" id="cancelWeightBtn" style="flex:1">取消</button>
      <button class="btn btn-primary" id="saveWeightBtn" style="flex:1">保存</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function(){
'use strict';

// ============ 存储键 ============
const K_PROFILE = 'diet_pro_profile_v2';
const K_LOGS = 'diet_pro_logs_v2';
const K_WEIGHTS = 'diet_pro_weights_v2';

// ============ 状态 ============
let profile = null;      // {sex, age, height, weight, target, activity}
let logs = [];           // [{id, name, cal, source, time}]
let weights = [];        // [{date, weight}]
let selectedFile = null;
let previewUrl = null;

const $ = id => document.getElementById(id);
const $$ = s => document.querySelectorAll(s);

// ============ 工具 ============
const genId = () => Date.now().toString(36) + Math.random().toString(36).slice(2,7);
const todayKey = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; };

function showToast(msg){
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(showToast._t); showToast._t = setTimeout(()=>t.classList.remove('show'),2000);
}
function escapeHtml(s){ const d=document.createElement('div'); d.textContent=s==null?'':String(s); return d.innerHTML; }

// ============ 存储 ============
function saveProfile(){ localStorage.setItem(K_PROFILE, JSON.stringify(profile)); }
function loadProfile(){ try{ const s=localStorage.getItem(K_PROFILE); return s?JSON.parse(s):null; }catch(e){ return null; } }
function saveLogs(){ localStorage.setItem(K_LOGS, JSON.stringify({date:todayKey(), logs})); }
function loadLogs(){
  try{
    const s = localStorage.getItem(K_LOGS); if(!s) return [];
    const d = JSON.parse(s);
    return d.date === todayKey() ? (d.logs||[]) : [];
  }catch(e){ return []; }
}
function saveWeights(){ localStorage.setItem(K_WEIGHTS, JSON.stringify(weights)); }
function loadWeights(){ try{ const s=localStorage.getItem(K_WEIGHTS); return s?JSON.parse(s):[]; }catch(e){ return []; } }

// ============ 核心算法 ============
// Mifflin-St Jeor 公式
function calcBMR(p){
  const base = 10 * p.weight + 6.25 * p.height - 5 * p.age;
  return Math.round(p.sex === 'male' ? base + 5 : base - 161);
}
function calcTDEE(p){
  return Math.round(calcBMR(p) * parseFloat(p.activity));
}
// 建议缺口：安全范围 300-500，且摄入不低于 BMR
function calcRecommendedDeficit(p){
  const tdee = calcTDEE(p);
  const bmr = calcBMR(p);
  // 目标：每周减 0.5kg ≈ 每天 500 kcal
  // 但摄入不能低于 BMR 的 0.85 倍
  const minIntake = Math.round(bmr * 0.85);
  const idealDeficit = 500;
  // 如果 TDEE - 500 低于 minIntake，则缩减缺口
  let deficit = idealDeficit;
  if (tdee - deficit < minIntake) {
    deficit = tdee - minIntake;
  }
  // 缺口最小 200，最大 700（安全上限）
  deficit = Math.max(200, Math.min(700, deficit));
  return Math.round(deficit);
}
// 建议每日摄入 = TDEE - 建议缺口
function calcTargetIntake(p){
  return calcTDEE(p) - calcRecommendedDeficit(p);
}
// 预计多少周达到目标
function calcWeeksToTarget(p){
  const diff = p.weight - p.target;
  if (diff <= 0) return 0;
  const deficit = calcRecommendedDeficit(p);
  // 每 kg 脂肪 ≈ 7700 kcal
  const totalKcal = diff * 7700;
  const days = totalKcal / deficit;
  return Math.ceil(days / 7);
}
// BMI
function calcBMI(p){
  return (p.weight / Math.pow(p.height/100, 2)).toFixed(1);
}

// ============ 渲染主界面 ============
function renderAll(){
  if (!profile) {
    $('setupCard').classList.remove('hidden');
    $('mainCard').classList.add('hidden');
    $('cameraCard').classList.add('hidden');
    $('manualCard').classList.add('hidden');
    $('logCard').classList.add('hidden');
    return;
  }

  $('setupCard').classList.add('hidden');
  ['mainCard','cameraCard','manualCard','logCard'].forEach(id=>$(id).classList.remove('hidden'));

  // 日期
  const d = new Date();
  const week = ['日','一','二','三','四','五','六'][d.getDay()];
  $('dateBadge').textContent = `${d.getMonth()+1}.${d.getDate()} 周${week}`;
  $('greeting').textContent = `你好，目标 ${profile.target}kg`;

  // 方案摘要
  const bmr = calcBMR(profile);
  const tdee = calcTDEE(profile);
  const deficit = calcRecommendedDeficit(profile);
  const targetIntake = calcTargetIntake(profile);

  $('bmrText').textContent = bmr;
  $('tdeeText').textContent = tdee;
  $('targetIntakeText').textContent = targetIntake;

  // 建议文案
  const bmi = calcBMI(profile);
  const weeks = calcWeeksToTarget(profile);
  const diff = (profile.weight - profile.target).toFixed(1);
  let advice = '';
  if (diff <= 0) {
    advice = `你的体重已达到目标 🎉 建议保持当前饮食，适当运动。`;
  } else {
    advice = `根据你的数据，建议每日摄入 <b>${targetIntake} kcal</b>，缺口约 <b>${deficit} kcal</b>。`;
    if (weeks > 0 && weeks < 200) {
      advice += ` 按此节奏，约 <b>${weeks} 周</b>可减到目标体重。`;
    }
    if (bmi < 18.5) advice += ` ⚠️ 你的BMI偏低(${bmi})，建议先咨询医生。`;
    else if (bmi >= 28) advice += ` BMI ${bmi}，属于肥胖范围，建议配合运动。`;
    else advice += ` BMI ${bmi}，属于正常/超重范围，继续保持。`;
  }
  $('adviceText').innerHTML = advice;

  // 今日数据
  const total = logs.reduce((s,l)=>s+(l.cal||0),0);
  const todayDeficit = tdee - total;
  const remain = Math.max(0, targetIntake - total);
  const eatPct = Math.min(100, (total / targetIntake) * 100);

  $('intakeVal').innerHTML = `${total}<small>kcal</small>`;
  $('intakeSub').textContent = logs.length === 0 ? '暂无记录' : `${logs.length} 条记录`;
  $('deficitVal').innerHTML = `${todayDeficit}<small>kcal</small>`;
  if (todayDeficit >= 500) $('deficitSub').textContent = '🎉 超额达成';
  else if (todayDeficit >= 300) $('deficitSub').textContent = '👍 缺口良好';
  else if (todayDeficit > 0) $('deficitSub').textContent = `目标 ${deficit} kcal`;
  else $('deficitSub').textContent = `⚠️ 超出消耗`;

  $('remainText').textContent = `${remain} kcal`;
  $('eatenText').textContent = total;
  $('limitText').textContent = targetIntake;
  $('intakeProg').style.width = eatPct + '%';

  // 记录列表
  renderLogList();
  // 体重历史
  renderWeightHistory();
}

